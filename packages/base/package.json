{
  "name": "@renton/eslint-config",
  "type": "module",
  "version": "0.2.0",
  "description": "Base ESLint configuration for TypeScript and JavaScript projects",
  "author": "Rikka <admin@rikka.cc>",
  "license": "MIT",
  "homepage": "https://github.com/Muromi-Rikka/eslint-config/tree/main/packages/base#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/eslint-config.git",
    "directory": "packages/base"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "javascript",
    "lint"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "import": "./dist/utils.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build:typegen && tsdown",
    "build:typegen": "tsx scripts/typegen.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@antfu/install-pkg": "catalog:dev",
    "@clack/prompts": "catalog:dev",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:plugins",
    "@eslint/js": "catalog:plugins",
    "@eslint/markdown": "catalog:plugins",
    "@stylistic/eslint-plugin": "catalog:plugins",
    "@vitest/eslint-plugin": "catalog:plugins",
    "eslint-config-flat-gitignore": "catalog:plugins",
    "eslint-flat-config-utils": "catalog:plugins",
    "eslint-plugin-antfu": "catalog:plugins",
    "eslint-plugin-command": "catalog:plugins",
    "eslint-plugin-format": "catalog:plugins",
    "eslint-plugin-import-lite": "catalog:plugins",
    "eslint-plugin-jsdoc": "catalog:plugins",
    "eslint-plugin-jsonc": "catalog:plugins",
    "eslint-plugin-n": "catalog:plugins",
    "eslint-plugin-no-only-tests": "catalog:plugins",
    "eslint-plugin-perfectionist": "catalog:plugins",
    "eslint-plugin-pnpm": "catalog:plugins",
    "eslint-plugin-regexp": "catalog:plugins",
    "eslint-plugin-unicorn": "catalog:plugins",
    "eslint-plugin-unused-imports": "catalog:plugins",
    "eslint-plugin-yml": "catalog:plugins",
    "find-up-simple": "catalog:plugins",
    "globals": "catalog:plugins",
    "jsonc-eslint-parser": "catalog:plugins",
    "local-pkg": "catalog:plugins",
    "typescript-eslint": "catalog:plugins",
    "yaml-eslint-parser": "catalog:plugins"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "eslint-typegen": "catalog:dev",
    "tsdown": "catalog:",
    "tsx": "catalog:dev",
    "typescript": "catalog:"
  }
}
