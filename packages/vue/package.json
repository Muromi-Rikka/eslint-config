{
  "name": "@renton/eslint-config-vue",
  "type": "module",
  "version": "0.1.3",
  "description": "ESLint configuration for Vue.js and Vue I18n projects",
  "author": "Rikka <admin@rikka.cc>",
  "license": "MIT",
  "homepage": "https://github.com/Muromi-Rikka/eslint-config/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/eslint-config.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "vue",
    "vuejs",
    "vue-i18n",
    "lint"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@renton/eslint-config": "workspace:*",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@intlify/eslint-plugin-vue-i18n": "catalog:plugins",
    "@renton/eslint-config": "workspace:*",
    "@renton/eslint-config-frontend": "workspace:*",
    "eslint-plugin-vue": "catalog:plugins",
    "vue-eslint-parser": "catalog:plugins"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
