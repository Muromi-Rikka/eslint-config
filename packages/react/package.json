{
  "name": "@renton/eslint-config-react",
  "type": "module",
  "version": "0.1.3",
  "description": "ESLint configuration for React, Next.js, and React Query projects",
  "author": "Rikka <admin@rikka.cc>",
  "license": "MIT",
  "homepage": "https://github.com/Muromi-Rikka/eslint-config/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/eslint-config.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "react",
    "nextjs",
    "react-query",
    "lint"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@renton/eslint-config": "workspace:*",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "catalog:plugins",
    "@next/eslint-plugin-next": "catalog:plugins",
    "@renton/eslint-config": "workspace:*",
    "@renton/eslint-config-frontend": "workspace:*",
    "@tanstack/eslint-plugin-query": "catalog:plugins",
    "@tanstack/eslint-plugin-router": "catalog:plugins",
    "eslint-plugin-react-hooks": "catalog:plugins",
    "eslint-plugin-react-refresh": "catalog:plugins"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
