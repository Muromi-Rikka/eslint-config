{
  "name": "@renton/eslint-config-frontend",
  "version": "0.1.1",
  "description": "ESLint configuration for frontend projects with Tailwind CSS support",
  "author": "Rikka <admin@rikka.cc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/eslint-config.git",
    "directory": "packages/frontend"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/eslint-config/issues"
  },
  "homepage": "https://github.com/Muromi-Rikka/eslint-config/tree/main/packages/frontend#readme",
  "keywords": [
    "eslint",
    "eslint-config",
    "frontend",
    "tailwindcss",
    "lint"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@renton/eslint-config": "workspace:*",
    "eslint-plugin-tailwindcss": "catalog:plugins"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@renton/eslint-config": "workspace:*",
    "eslint": "^9.0.0 || ^10.0.0"
  }
}
