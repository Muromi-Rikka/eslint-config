{
  "name": "@renton/eslint-config-cli",
  "type": "module",
  "version": "0.1.1",
  "description": "CLI for @renton/eslint-config setup",
  "author": "Rikka <admin@rikka.cc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/eslint-config.git",
    "directory": "packages/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "renton-eslint": "./dist/index.mjs"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@antfu/install-pkg": "catalog:dev",
    "@clack/prompts": "catalog:dev",
    "@renton/eslint-config": "workspace:*",
    "ansis": "catalog:dev",
    "cac": "catalog:dev"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:dev",
    "typescript": "catalog:"
  }
}
