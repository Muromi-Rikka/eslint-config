{
  "name": "@renton/eslint-config-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:packages": "pnpm -r run lint",
    "changeset": "changeset",
    "release": "changeset publish",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@renton/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "tinyexec": "^1.0.0",
    "tinyglobby": "^0.2.14",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.1"
  }
}
