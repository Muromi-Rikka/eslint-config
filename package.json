{
  "name": "@renton/eslint-config-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:packages": "pnpm -r run lint",
    "changeset": "changeset",
    "release": "changeset publish",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:dev",
    "@changesets/cli": "catalog:dev",
    "@renton/eslint-config": "workspace:*",
    "@types/node": "catalog:dev",
    "eslint": "catalog:",
    "tinyexec": "catalog:dev",
    "tinyglobby": "catalog:dev",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:dev"
  }
}
