{
  "name": "@renton/eslint-config-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:packages": "pnpm -r run lint",
    "release": "pnpm -r run release",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@renton/eslint-config": "workspace:*",
    "eslint": "^10.9.0",
    "tinyexec": "^1.0.0",
    "tinyglobby": "^0.2.14",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.1"
  }
}
